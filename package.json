    "d3": "^7.9.0",
    "solid-js": "^1.9.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
