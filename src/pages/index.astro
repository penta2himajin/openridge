---
import "../styles/global.css";
import App from "../components/App";

const title = "OpenRidge — Pareto frontier of open-weight LLMs";
const description =
  "Single-screen visualisation of the Pareto-efficient frontier among self-hostable open-weight LLMs, with closed-model anchors for reference.";
// Absolute URL required by crawlers. Prefer the configured Astro `site`, fall
// back to the public domain so local builds without SITE_URL still emit a
// usable card.
const siteOrigin = Astro.site?.origin ?? "https://openridge.dev";
const ogImage = new URL("og.png", `${siteOrigin}/`).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1A1B22" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
  </head>
  <body class="h-viewport overflow-hidden">
    <App client:load />
  </body>
</html>
